#lang racket/base

;; Conformance vectors for the ABI encoders, as values.  The data file is
;; generated by tests/generate-abi-vectors.rkt.

(require racket/contract/base
         racket/runtime-path)

(provide (contract-out
          (struct abi-vector ([mode (or/c 'encode 'packed 'call)]
                              [name string?]
                              [signature string?]
                              [values list?]
                              [hex string?]))
          [abi-encode-vectors (listof abi-vector?)]))

(define-runtime-path encode-path "vectors/encode.rktd")

(struct abi-vector (mode name signature values hex) #:transparent)

(define abi-encode-vectors
  (call-with-input-file encode-path
    (lambda (in)
      (for/list ([entry (in-port read in)])
        (apply abi-vector entry)))))
