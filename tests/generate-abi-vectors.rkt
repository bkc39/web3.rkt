#lang racket/base

;; Regenerates the hex column of abi/vectors/encode.rktd with cast:
;;
;;   nix develop --command racket tests/generate-abi-vectors.rkt

(module+ main
  (require racket/match
           racket/port
           racket/runtime-path
           "cast.rkt")

  (define-runtime-path encode-path "../abi/vectors/encode.rktd")

  (unless cast-path
    (error 'generate-abi-vectors "cast not found (set WEB3_CAST or use `nix develop`)"))

  (define entries (call-with-input-file encode-path (lambda (in) (port->list read in))))

  (define regenerated
    (for/list ([entry (in-list entries)])
      (match-define (list mode name signature vs _) entry)
      (list mode name signature vs (cast-encode mode signature vs))))

  (call-with-output-file encode-path #:exists 'truncate
    (lambda (out)
      (fprintf out ";; Generated by tests/generate-abi-vectors.rkt with cast ~a. Edit the inputs, then regenerate.\n"
               (cast-version))
      (for ([entry (in-list regenerated)])
        (writeln entry out)))))
